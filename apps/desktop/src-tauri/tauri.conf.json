{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flick",
  "identifier": "dev.akshitbansal.flick",
  "version": "0.0.1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "url": "index.html",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "width": 640,
        "height": 92,
        "resizable": false,
        "transparent": true,
        "focus": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBOTk2NzMyNzJDNjYzQzEKUldUQlk4WnlNbWVaaXNkMmMxb0U2ejAzdFpWTWJyZ2FPRXZzbWFPVVU1ZHdRQ3RGN3J1L2hoeEYK",
      "endpoints": [
        "https://github.com/akshit-bansal11/flick/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
