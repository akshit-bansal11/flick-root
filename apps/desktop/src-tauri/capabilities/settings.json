{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: listen to events and settings commands only",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "allow-open-settings",
    "allow-open-link",
    "allow-get-settings",
    "allow-set-general",
    "allow-get-appearance",
    "allow-set-appearance",
    "allow-set-roots",
    "allow-set-program-skip",
    "allow-clear-history",
    "allow-list-features",
    "allow-set-feature-enabled",
    "allow-set-mode-enabled",
    "allow-set-feature-options",
    "allow-list-providers",
    "allow-probe-providers",
    "allow-set-provider",
    "allow-set-provider-order",
    "allow-list-engines",
    "allow-probe-decision-engines",
    "allow-set-engine",
    "allow-get-integrations",
    "allow-set-integration",
    "allow-connect-spotify",
    "allow-disconnect-spotify",
    "allow-test-capture-target",
    "allow-set-secret",
    "allow-delete-secret",
    "allow-test-secret",
    "allow-list-secrets",
    "allow-reindex",
    "allow-get-first-run",
    "allow-complete-first-run",
    "allow-set-tutorial-done",
    "allow-get-about",
    "allow-set-hotkeys-paused"
  ]
}
