{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Launcher window: listen to events and launcher commands only",
  "windows": [
    "launcher"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-report-shown",
    "allow-hide-launcher",
    "allow-open-settings",
    "allow-search",
    "allow-launch",
    "allow-reveal",
    "allow-copy-path",
    "allow-open-link",
    "allow-run-system-command",
    "allow-kill-process",
    "allow-ask-stream",
    "allow-cancel-ask",
    "allow-resize-launcher",
    "allow-get-first-run",
    "allow-complete-first-run",
    "allow-register-hotkey",
    "allow-probe-providers"
  ]
}
