{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Launcher window: listen to events and launcher commands only",
  "windows": ["launcher"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-report-shown",
    "allow-hide-launcher",
    "allow-resize-launcher",
    "allow-open-settings",
    "allow-tray-action",
    "allow-search",
    "allow-home-items",
    "allow-launch",
    "allow-reveal",
    "allow-copy-path",
    "allow-copy-text",
    "allow-open-link",
    "allow-web-search",
    "allow-run-system-command",
    "allow-ask-stream",
    "allow-cancel-ask",
    "allow-list-thinking-modes",
    "allow-set-thinking-mode",
    "allow-get-first-run",
    "allow-complete-first-run",
    "allow-probe-providers",
    "allow-list-themes"
  ]
}
